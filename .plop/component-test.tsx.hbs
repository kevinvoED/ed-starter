import type { ModuleProps } from "@/sanity/lib/fetch";
import { render } from "@testing-library/react";
import { {{pascalCase name}} } from "@/components/modules/{{pascalCase category}}/{{pascalCase name}}";
import { describe, expect, test } from "vitest";

const TITLE_BLOCK: ModuleProps<"{{kebabCase name}}">["title"] = [
  {
    _type: "block",
    _key: "t1",
    children: [{ _type: "span", _key: "s1", marks: [], text: "My Title" }],
    markDefs: [],
    style: "normal",
  },
];

const DESCRIPTION_BLOCK: ModuleProps<"{{kebabCase name}}">["description"] = [
  {
    _type: "block",
    _key: "d1",
    children: [
      { _type: "span", _key: "s2", marks: [], text: "Card description." },
    ],
    markDefs: [],
    style: "normal",
  },
];

const props: ModuleProps<"{{kebabCase name}}"> = {
  _type: "{{kebabCase name}}",
  _key: "base",
  title: TITLE_BLOCK,
  description: DESCRIPTION_BLOCK,
  image: {
    _type: "image",
    alt: "Test card image",
    asset: {
      _id: "image-abc123def456abc1-100x100-jpg",
      url: "https://example.com",
      metadata: { lqip: null, dimensions: { width: 100, height: 100 } },
    },
  },
  link: [
    {
      _key: "lnk1",
      _type: "link",
      type: "external",
      href: "https://example.com",
      label: "Learn more",
    },
  ],
};

describe("{{pascalCase name}}", () => {
  test("returns null when title is not provided", () => {
    const { container } = render(
      // @ts-expect-error intentional missing required prop for null guard test
      <{{pascalCase name}} />,
    );
    expect(container.firstChild).toBeNull();
  });

  test("renders title", () => {
    const { getByText } = render(<{{pascalCase name}} {...props} />);
    expect(getByText("My Title")).toBeInTheDocument();
  });

  test("renders description when provided", () => {
    const { getByText } = render(<{{pascalCase name}} {...props} />);
    expect(getByText("Card description.")).toBeInTheDocument();
  });

  test("matches snapshot", () => {
    const { asFragment } = render(<{{pascalCase name}} {...props} />);
    expect(asFragment()).toMatchSnapshot();
  });

  test("renders image when provided", () => {
    const { getByRole } = render(<{{pascalCase name}} {...props} />);
    expect(getByRole("img", { name: "Test card image" })).toBeInTheDocument();
  });

  test("renders CTA link when provided", () => {
    const { getByRole } = render(<{{pascalCase name}} {...props} />);
    const link = getByRole("link", { name: /Learn more/i });
    expect(link).toBeInTheDocument();
    expect(link).toHaveAttribute("href", "https://example.com");
  });
});
