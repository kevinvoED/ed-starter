{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": [
    "./.biome/no-anchor-element.grit",
    "./.biome/no-native-next-link.grit",
    "./.biome/no-arbitrary-colors.grit",
    "./.biome/no-h-screen-class.grit",
    "./.biome/no-react-fc.grit"
  ],
  "files": {
    "ignoreUnknown": false,
    "maxSize": 20971520,
    "includes": [
      "frontend/**",
      "studio/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.mjs",
      "*.json",
      "*.jsonc",
      "*.css",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/.sanity",
      "!!frontend/sanity.types.ts",
      "!!studio/schema.json",
      "!!studio/tsconfig.tsbuildinfo"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "correctness": {
        "noInvalidPositionAtImportRule": "off",
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "allowWrongLineComments": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              { "type": true, "source": ["**"] },
              ["react", "react*", "*react", "*/react"],
              ["@next", "@next/**", "next", "next/**", "next-*", "next-*/**"],
              [
                "@/sanity/**",
                "@sanity/**",
                "sanity",
                "sanity/**",
                "sanity-plugin-media",
                "sanity-plugin-iframe-pane",
                "sanity-plugin-dashboard-widget-vercel",
                "class-variance-authority",
                "clean-react-props",
                "@gsap/**",
                "gsap",
                "lodash-es",
                "es-toolkit",
                "nuqs"
              ],
              ["!@/styles/**", ":ALIAS:", "@/**"],
              ["@/components/**", "@components/**", "radix-ui/**"],
              ["@utility/**", "./**", "./globals.css", "lucide-react"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.cjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "error",
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noUnusedImports": {
              "level": "warn",
              "fix": "none"
            },
            "useParseIntRadix": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "noNegationElse": "warn",
            "noNestedTernary": "warn",
            "noUselessElse": "warn",
            "noYodaExpression": "warn",
            "noSubstr": "warn",
            "noUnusedTemplateLiteral": "warn",
            "noEnum": "warn",
            "noImplicitBoolean": "warn",
            "noShoutyConstants": "warn",
            "useConst": "error",
            "useCollapsedElseIf": "warn",
            "useConsistentArrayType": {
              "level": "on",
              "options": {
                "syntax": "shorthand"
              }
            }
          },
          "suspicious": {
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noRedeclare": "off",
            "noUnsafeNegation": "off",
            "useGetterReturn": "off",
            "noVar": "error",
            "noArrayIndexKey": "off"
          },
          "complexity": {
            "noArguments": "error"
          },
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "fix": "unsafe",
              "options": {
                "attributes": ["className", "tw", "classList"],
                "functions": ["clsx", "cva", "tw", "tw.*"]
              }
            }
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/app/globals.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "frontend/components/**/*.ts",
        "frontend/components/**/*.tsx",
        "frontend/components/**/*.js",
        "frontend/components/**/*.jsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "filenameCases": ["PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/lib/**/*.ts",
        "frontend/lib/**/*.css",
        "frontend/sanity/lib/*.ts",
        "frontend/sanity/queries/**/*.ts",
        "studio/lib/*.ts",
        "studio/schemas/documents/*.ts",
        "studio/schemas/modules/*.ts",
        "studio/schemas/objects/*.ts",
        "studio/schemas/pages/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["frontend/app/globals.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          },
          "correctness": {
            "noUnknownFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/public/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
