{
  "name": "studio",
  "version": "1.0.0",
  "description": "ED Sanity Studio",
  "homepage": "https://enginedigital.com",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.22.0",
    "npm": "Please use pnpm instead of npm."
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "NODE_NO_WARNINGS=1 sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typegen": "rm -rf schema.json && NODE_NO_WARNINGS=1 sanity schema extract --enforce-required-fields && NODE_NO_WARNINGS=1 sanity typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@portabletext/react": "^8.0.0",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/assist": "^6.1.19",
    "@sanity/dashboard": "^6.0.16",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.20",
    "@sanity/preview-url-secret": "^4.1.4",
    "@sanity/ui": "^3.5.0",
    "@sanity/vision": "^6.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.51.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-player": "^3.4.0",
    "sanity": "6.10.1",
    "sanity-plugin-dashboard-widget-vercel": "^4.0.26",
    "sanity-plugin-iframe-pane": "^5.0.33",
    "sanity-plugin-media": "^6.1.4",
    "sanity-plugin-simpler-color-input": "^4.0.0",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@sanity/client": "^7.25.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@sanity/types": "6.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2"
  }
}
