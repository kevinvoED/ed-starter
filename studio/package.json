{
  "name": "studio",
  "version": "1.0.0",
  "description": "ED Sanity Studio",
  "homepage": "https://enginedigital.com",
  "private": true,
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.1.1",
    "npm": "Please use pnpm instead of npm."
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "NODE_NO_WARNINGS=1 sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typegen": "rm -rf schema.json && NODE_NO_WARNINGS=1 sanity schema extract --enforce-required-fields && NODE_NO_WARNINGS=1 sanity typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@portabletext/react": "^6.2.0",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/assist": "^6.1.9",
    "@sanity/dashboard": "^6.0.12",
    "@sanity/icons": "^5.1.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.8",
    "@sanity/preview-url-secret": "^4.0.8",
    "@sanity/ui": "^3.3.5",
    "@sanity/vision": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.49.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-player": "^3.4.0",
    "sanity": "6.1.0",
    "sanity-plugin-dashboard-widget-vercel": "^4.0.19",
