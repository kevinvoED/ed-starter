    "sanity-plugin-simpler-color-input": "^4.0.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@sanity/client": "^7.24.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@sanity/types": "6.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2"
